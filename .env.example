# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_SECRET=long_random_string          # also used as secret_token in setWebhook
PUBLIC_BASE_URL=https://your-app.vercel.app
ADMIN_TELEGRAM_IDS=123456789               # who may use /status (comma separated)

# VirusTotal v3
VIRUSTOTAL_API_KEY=your_virustotal_v3_api_key_here

# Optional LLM second opinion for borderline messages
OPENAI_API_KEY=
GEMINI_API_KEY=

# Dashboard / API protection (required to use /api/*)
ADMIN_TOKEN=long_random_string

# Supabase (use the SERVICE ROLE key, enable RLS on scan_logs)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Privacy
STORE_MESSAGE_TEXT=hash                    # hash | full
RETENTION_DAYS=30

# Server
PORT=8000
HOST=0.0.0.0
